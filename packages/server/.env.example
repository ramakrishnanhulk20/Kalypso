# Network. Only testnet is accepted.
NETWORK=testnet
# Stellar RPC endpoint. Leave blank for https://soroban-testnet.stellar.org
RPC_URL=
# Our deployed payroll contract (C...).
PAYROLL_CONTRACT_ID=
# Our deployed confidential token contract (C...).
TOKEN_CONTRACT_ID=
# Circle's testnet USDC token contract. Leave blank for CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
USDC_SAC_ID=
# Our deployed auditor registry contract (C...).
AUDITOR_CONTRACT_ID=
# Our deployed proof verifier contract (C...); the sponsor lets a call touch its storage and code.
VERIFIER_CONTRACT_ID=
# Wasm hash a worker's passkey wallet must run before the sponsor pays for it. Leave blank for 97ce047884106b1c6c3bb40b8973cc48db1c4dad95c9e20462bf2c701daa764e (passkey-kit 0.19.1 testnet wallet).
PASSKEY_WALLET_WASM_HASH=
# OpenZeppelin Channels endpoint. Leave blank for https://channels.openzeppelin.com/testnet
CHANNELS_URL=
# Secret. Channels testnet API key; get one at https://channels.openzeppelin.com/testnet/gen
CHANNELS_API_KEY=
# Secret. Postgres URL for the role that writes: ingest job, lazy catch-up and sponsor counters.
DATABASE_URL_INGEST=
# Secret. Postgres URL for the read-only role the archive API reads with (see src/archive/schema.sql).
DATABASE_URL_API=
# Most the sponsor pays for one transaction, in stroops. Leave blank for 2000000 (0.2 XLM).
FEE_CAP_STROOPS=
# Most the sponsor spends per UTC day, in stroops. Leave blank for 200000000 (20 XLM).
DAILY_FEE_BUDGET_STROOPS=
# Sponsor requests allowed per client IP (IPv6: per /64) per hour. Leave blank for 60.
PER_IP_LIMIT_PER_HOUR=
# Relays allowed per authorising address (the worker's G or C account) per UTC day, whatever IP they come from. Leave blank for 20.
PER_ADDRESS_LIMIT_PER_DAY=
# Header the hosting platform sets to the caller's real IP. Leave blank for x-real-ip (Vercel).
TRUSTED_IP_HEADER=
# Secret, 32 to 256 characters. A scheduler must call POST /api/archive/ingest with "Authorization: Bearer <this value>" at least once a day; Vercel Cron sends it by itself when this variable is set. Make one with: openssl rand -hex 32
# Alarm: GET /api/archive/v1/health answers 503 (not 200) while there is a history gap or no successful ingest for 48 hours. Point an uptime check or a scheduled GitHub job at it.
CRON_SECRET=
# Secret, 32 to 256 characters, different from CRON_SECRET. Key for the tag that stands in for a caller's IP in sponsor log lines; never share it. Make one with: openssl rand -hex 32
LOG_SALT=
# Ledger an empty archive starts reading from. Copy contracts.token.deployTx.ledger from packages/contracts/deployments/testnet.json; never type a guess. Leave blank to start at RPC's oldest ledger.
ARCHIVE_START_LEDGER=
# The token's deploy transaction hash. Copy contracts.token.deployTx.hash from the same file. The archive vouches for ledgers before ARCHIVE_START_LEDGER only when the first token events it reads there come from this transaction; leave blank and it never does.
TOKEN_DEPLOY_TX=
