{
  "name": "@kalypso/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kalypso fee sponsor and event archive: framework-free Web Fetch handlers.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:wire": "vitest run --mode wire",
    "typecheck": "tsc -p tsconfig.json",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.3.1",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "axios": "1.20.0"
  }
}
