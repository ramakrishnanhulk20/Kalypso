# Copy to .env (git-ignored). None of these is a secret; the deployer's key lives only in the stellar CLI store at packages/contracts/.stellar.

# Name of the stellar CLI identity that deploys and signs. Created and friendbot-funded on first run if missing.
DEPLOYER=kalypso-deployer

# Path to the stellar CLI (28.1.0). Leave empty to use `stellar` on PATH, then ~/.local/bin.
STELLAR_BIN=

# Cargo's build folder, if not packages/contracts/target. The default --wasm-dir is $CARGO_TARGET_DIR/wasm32v1-none/release.
CARGO_TARGET_DIR=

# Optional https base URL of a Kalypso archive server. prove:testnet then reads history older than RPC's 7 days from it (same as --archive).
ARCHIVE_URL=
