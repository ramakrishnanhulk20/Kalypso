# Server variables for the fee sponsor and the event archive (app/api). With
# none of them set, every /api route answers 503 not_configured and the pages
# work as usual. In production they live in Vercel's Environment Variables.

# The only network the server accepts. Set it to: testnet
NETWORK=
# Stellar RPC endpoint. Leave blank for https://soroban-testnet.stellar.org
RPC_URL=
# Public. Our payroll contract: contracts.payroll.id in packages/contracts/deployments/testnet.json
PAYROLL_CONTRACT_ID=CBUIUWF6PLCQHTLYUCYIKB34DCFXJG722N2JWE44LVICRCEY34KK7XVZ
# Public. Our confidential token contract: contracts.token.id in the same file
TOKEN_CONTRACT_ID=CASNAZGPARZ46BT7IWDDHNZKCHMUWQ35FY4YR4S6YLE45CAJQUPSTTBZ
# Circle's testnet USDC token contract. Leave blank for CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
USDC_SAC_ID=
# Public. Our auditor registry contract: contracts.auditorRegistry.id in the same file
AUDITOR_CONTRACT_ID=CBG6BCHMPMKQGXAVIU475Q7TGFROD6BGZ5BQFEFBXWTOGSGF542AUZYG
# Public. Our proof verifier contract: contracts.verifier.id in the same file
VERIFIER_CONTRACT_ID=CDPF25R2OEACPIOPWSUMZUQHOPW2OYSRTAOHUU27AGNF5CFLFALWDPYM
# Wasm hash a worker's passkey wallet must run for the sponsor to pay. Leave blank for passkey-kit 0.19.1's testnet wallet.
PASSKEY_WALLET_WASM_HASH=
# OpenZeppelin Channels endpoint. Leave blank for https://channels.openzeppelin.com/testnet
CHANNELS_URL=
# Secret. Channels testnet API key: open https://channels.openzeppelin.com/testnet/gen and copy the apiKey value.
CHANNELS_API_KEY=
# Secret. Neon owner role's direct URL (host without -pooler), via Vercel's Neon integration, ending ?sslmode=verify-full (drop channel_binding). Writes: ingest, catch-up, sponsor counters.
DATABASE_URL_INGEST=
# Secret. The same direct URL with the read-only kalypso_api role's name and password (SQL in packages/server/src/archive/schema.sql), ending ?sslmode=verify-full. The archive reads with it.
DATABASE_URL_API=
# Most the sponsor pays for one passkey wallet creation, in stroops. Leave blank for 25000000 (2.5 XLM, testnet), above a creation's measured 1.79 XLM.
FEE_CAP_CREATION_STROOPS=
# Most the sponsor pays for any other request, in stroops. Leave blank for 10000000 (1 XLM, testnet). Replaces FEE_CAP_STROOPS: delete that one from Vercel, or the server will not start.
FEE_CAP_CALL_STROOPS=
# Most the sponsor spends per UTC day, in stroops. Leave blank for 2000000000 (200 XLM, testnet), about 48 passkey worker joins at the default share.
DAILY_FEE_BUDGET_STROOPS=
# Percent of each day's budget that wallet creations may use, so sign-ups can never spend existing workers' fees. Leave blank for 50.
CREATION_BUDGET_SHARE_PERCENT=
# Sponsor requests allowed per client IP (IPv6: per /64) per hour. Leave blank for 60.
PER_IP_LIMIT_PER_HOUR=
# Relays allowed per authorising address per UTC day, whatever IP they come from. Leave blank for 20.
PER_ADDRESS_LIMIT_PER_DAY=
# Passkey wallet creations the sponsor pays for per client IP (IPv6: per /48) per UTC day. Leave blank for 3.
WALLET_CREATIONS_PER_IP_PER_DAY=
# Passkey wallet creations the sponsor pays for per UTC day across the whole service. Leave blank for 60.
WALLET_CREATIONS_PER_DAY=
# Web origins whose passkey sign-ups the sponsor pays a wallet creation for, comma-separated. Blank refuses every creation. Local development adds http://localhost:3001 (accepted only outside production).
SPONSOR_ALLOWED_ORIGINS=https://kalypso-payroll.vercel.app
# Header the host sets to the caller's real IP. Leave blank for x-real-ip, which Vercel sets. Under next dev use x-forwarded-for (a caller can forge it there, so never in production).
TRUSTED_IP_HEADER=
# Secret. 32 random bytes in hex (openssl rand -hex 32), or the value in packages/server/.env. Vercel Cron sends it to /api/archive/ingest as a bearer token.
CRON_SECRET=
# Secret. 32 random bytes in hex, different from CRON_SECRET, or the value in packages/server/.env. Keys the tag that stands in for a caller's IP in logs.
LOG_SALT=
# Ledger an empty archive starts reading from: contracts.token.deployTx.ledger in packages/contracts/deployments/testnet.json. Never a guess.
ARCHIVE_START_LEDGER=
# The token's deploy transaction hash: contracts.token.deployTx.hash in the same file. Lets the archive prove no token history comes before it.
TOKEN_DEPLOY_TX=
# Development only. Set to 1 under `next dev`, with both DATABASE_URL_* blank, to run the archive and sponsor on an in-memory database that lasts until the dev server stops. Ignored in a production build.
KALYPSO_DEV_MEMORY_DB=
